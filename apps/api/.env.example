# Copy to .env and adjust as needed. All vars use the DC_ prefix.

DC_OLLAMA_BASE_URL=http://localhost:11434
DC_OLLAMA_MODEL=llama3:latest
DC_OLLAMA_TIMEOUT=120
DC_OLLAMA_TEMPERATURE=0

DC_MAX_SAMPLE_ROWS=15
DC_MAX_UPLOAD_MB=50
DC_PREVIEW_ROWS=50
DC_STORAGE_DIR=storage

# Set true only if ydata-profiling is installed (pip install ydata-profiling).
DC_ENABLE_YDATA_PROFILE=false
